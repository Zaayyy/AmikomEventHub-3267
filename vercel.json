{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "includeFiles": "**"
        }
    },
    "routes": [
        {
            "src": "^/build/(.*)$",
            "dest": "/build/$1"
        },
        {
            "src": "^/assets/(.*)$",
            "dest": "/assets/$1"
        },
        {
            "src": "^/(favicon\\.ico|favicon\\.png|robots\\.txt)$",
            "dest": "/$1"
        },
        {
            "src": "^/(.+\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map))$",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
